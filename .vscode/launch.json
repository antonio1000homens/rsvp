{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch frontend in Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Serve frontend (python)"
    },
    {
      "name": "Open README.html in Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "file": "${workspaceFolder}/README.html"
    }
  ]
}
