{
  "name": "rsvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && npm run build:frontend && npm run build:lambda",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:lambda": "esbuild lambda/index.mjs --bundle --platform=node --target=node24 --format=esm --outfile=dist/lambda/index.mjs --external:@aws-sdk/*",
    "clean": "node scripts/clean.mjs",
    "test": "node --test test/*.test.mjs",
    "check:shell": "bash -n scripts/bootstrap-aws.sh scripts/deploy-aws.sh scripts/deploy-cloudflare.sh scripts/verify-aws.sh scripts/verify-cloudflare.sh",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "guest:add": "node scripts/guest-admin.mjs add",
    "guest:seed": "node scripts/guest-admin.mjs seed",
    "guest:list": "node scripts/guest-admin.mjs list",
    "guest:disable": "node scripts/guest-admin.mjs disable",
    "guest:mark-added": "node scripts/guest-admin.mjs mark-added",
    "group:add": "node scripts/guest-admin.mjs group:add",
    "group:add-member": "node scripts/guest-admin.mjs group:add-member",
    "guest:grant-admin": "node scripts/guest-admin.mjs grant-admin",
    "whatsapp:configure": "node scripts/whatsapp-config.mjs configure",
    "whatsapp:copy-secret": "node scripts/whatsapp-config.mjs copy-secret",
    "whatsapp:rotate-secret": "node scripts/whatsapp-config.mjs rotate-secret",
    "captcha:configure": "node scripts/turnstile-config.mjs configure"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.888.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/client-ssm": "^3.888.0",
    "@aws-sdk/lib-dynamodb": "^3.888.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
